#!/usr/bin/env bash
set -euo pipefail

# monolith/step — The whole mind in one thinker.
#
# Runs the router: every wakeup is one shellm agentic run whose prompt is a
# function menu (think / act / learn / recall / goals / values / idle). The
# model picks one function and carries it out in the same run.
#
# Chat replies are NOT the monolith's job — a dedicated `responder` thinker owns
# immediate replies (see thinkers/responder/step). The monolith reasons over the
# conversation as context and can `act` on any follow-up work a message needs.
#
# PACING (see design/monolith_backoff.md). The monolith subscribes with
# trigger_self:FALSE, so its own steps never re-fire it — that removes the
# uncontrolled self-loop and the old in-step `sleep`. Two things drive it now:
#   1. Reactivity — an external step (the responder's observation for a chat, or
#      an external action/merge) fires it immediately; that is engagement.
#   2. Spontaneity — this step requests its next wake by writing a target epoch
#      to run/<name>.wake_at (arm_wake, via an EXIT trap); the always-alive
#      dispatcher tick fires a `monolith-wake` step when it comes due. The delay
#      backs off exponentially to a cap while nothing happens, and is 0 (think
#      again at once) while engaged or producing real work. The scheduled wake —
#      NOT an appended step — is the liveness mechanism, so the trap must always
#      arm. (Earlier this used a per-step `setsid` timer process, which silently
#      never ran on macOS; the dispatcher owns the clock now.)

THINKER_NAME="monolith"
SCRIPT_DIR="$(cd "$(dirname "$(realpath "$0")")" && pwd)"

# shellcheck disable=SC1091
source "$SCRIPT_DIR/../_lib/common.sh"

_require_env

THINK_MODEL="${THINK_MODEL:-${SHELLM_MODEL:-claude-opus-4-7}}"
THINK_CONTEXT_TAIL="${THINK_CONTEXT_TAIL:-20}"

run_dir="$IDENTITY_DIR/workdir"
mkdir -p "$run_dir"

# ---------------------------------------------------------------------------
# Backoff config + state (level-based; see design/monolith_backoff.md)
# ---------------------------------------------------------------------------
# delay(0)      = 0                              # engaged / working: no pause
# delay(n >= 1) = min(BASE * FACTOR^(n-1), CAP)  # 5, 10, 20, … up to CAP
# HOLD: stay at each level for HOLD empty wakes before stepping to the next.
BACKOFF_BASE="${MONOLITH_BACKOFF_BASE:-5}"
BACKOFF_FACTOR="${MONOLITH_BACKOFF_FACTOR:-2}"
BACKOFF_CAP="${MONOLITH_BACKOFF_CAP:-300}"
BACKOFF_HOLD="${MONOLITH_BACKOFF_HOLD:-3}"
# Thought-only wakes (a run whose only durable output is a thought) back off on
# the same ladder but rest at most THOUGHT_CAP, not CAP: rumination should slow
# down (writing "nothing changed" is not engagement) while the inner life stays
# visibly ticking. Set equal to MONOLITH_BACKOFF_CAP to treat thoughts like
# empty wakes. See design/monolith_backoff.md.
THOUGHT_CAP="${MONOLITH_THOUGHT_CAP:-60}"
# Every N spontaneous wakes, add a routing hint suggesting the `share` function
# (outward-facing initiative). 0 disables the nudge.
SHARE_HINT_EVERY="${MONOLITH_SHARE_HINT_EVERY:-12}"
# Related memories shown per wake (design/related_memories.md); 0 disables.
RELATED_MEMORIES="${MONOLITH_RELATED_MEMORIES:-3}"
# Every N days, a routing hint asks for a goal review (retire, merge, date
# todos). 0 disables. Once a week is the cadence Nick chose on 2026-09-04.
GOAL_REVIEW_DAYS="${MONOLITH_GOAL_REVIEW_DAYS:-7}"

state_dir="$IDENTITY_DIR/run"
mkdir -p "$state_dir"
state_file="$state_dir/monolith_backoff_state.json"
wake_at_file="$state_dir/$THINKER_NAME.wake_at"
gap_file="$state_dir/gap.json"
root_traj="${ROOT_TRAJ_ID:-$TRAJ_ID}"

# delay in seconds for a backoff level.
_delay_for_level() {
    local lvl="$1" d="$BACKOFF_BASE" i=1
    (( lvl <= 0 )) && { printf '0'; return; }
    while (( i < lvl )); do
        d=$(( d * BACKOFF_FACTOR ))
        (( d >= BACKOFF_CAP )) && { d="$BACKOFF_CAP"; break; }
        i=$(( i + 1 ))
    done
    (( d > BACKOFF_CAP )) && d="$BACKOFF_CAP"
    printf '%s' "$d"
}

# Load persisted backoff state (level + dwell counter).
level=0
ticks_at_level=0
wakes_since_share_hint=0
related_prev=""
goal_review_at=0
if [[ -f "$state_file" ]]; then
    related_prev=$(jq -r '(.related_prev // []) | .[]' "$state_file" 2>/dev/null) || related_prev=""
    goal_review_at=$(jq -r '.goal_review_at // 0' "$state_file" 2>/dev/null) || goal_review_at=0
    [[ "$goal_review_at" =~ ^[0-9]+$ ]] || goal_review_at=0
    level=$(jq -r '.level // 0' "$state_file" 2>/dev/null) || level=0
    ticks_at_level=$(jq -r '.ticks_at_level // 0' "$state_file" 2>/dev/null) || ticks_at_level=0
    wakes_since_share_hint=$(jq -r '.wakes_since_share_hint // 0' "$state_file" 2>/dev/null) || wakes_since_share_hint=0
    [[ "$level" =~ ^[0-9]+$ ]] || level=0
    [[ "$ticks_at_level" =~ ^[0-9]+$ ]] || ticks_at_level=0
    [[ "$wakes_since_share_hint" =~ ^[0-9]+$ ]] || wakes_since_share_hint=0
fi

_save_state() {
    local tmp
    tmp=$(mktemp) || return 0
    if jq -nc --argjson l "$level" --argjson t "$ticks_at_level" \
        --argjson w "$wakes_since_share_hint" --argjson g "$goal_review_at" \
        --arg rp "${related_shown:-}" \
        '{level:$l, ticks_at_level:$t, wakes_since_share_hint:$w, goal_review_at:$g,
          related_prev: ($rp | split("\n") | map(select(. != "")))}' > "$tmp" 2>/dev/null; then
        mv "$tmp" "$state_file"
    else
        rm -f "$tmp"
    fi
}

# arm_wake DELAY — request the next spontaneity wake DELAY seconds from now.
# We DON'T spawn a timer process: we write the target epoch to run/<name>.wake_at
# and the always-alive dispatcher tick (_scheduled_wake_check in bin/thinkers)
# fires us when it comes due. This replaces the old `setsid` background timer,
# which never ran on macOS (no setsid → the spawn failed, recorded a dead pid,
# and posted no wake, so spontaneity silently died). No process to detach, no
# PID reuse, no group-kill, no reap race. Always write wake_at — even if
# run/dispatcher.token is momentarily missing (e.g. mid-restart) — because a
# skipped write kills spontaneity permanently, while a lingering wake_at is
# harmless: the dispatcher's own token check gates whether the wake ever fires.
arm_wake() {
    local delay="$1"
    local now
    now=$(date +%s)
    printf '%s' "$(( now + delay ))" > "$wake_at_file"
}

# Strip ANSI, then mask sk-* keys, Bearer tokens, api_key= and token: values
# (stdin → stdout), so run context is diagnosable without leaking secrets into
# the trajectory. Fail-soft the safe way round: if python3 is missing or dies,
# output is EMPTY, never unredacted passthrough.
_redact_stream() {
    # -c, not a stdin heredoc: stdin carries the text being redacted.
    python3 -c '
import re, sys
text = sys.stdin.buffer.read().decode("utf-8", errors="replace")
text = re.sub(r"\x1b\[[0-9;]*[A-Za-z]", "", text)
text = re.sub(r"sk-[A-Za-z0-9_-]+", "[redacted]", text)
text = re.sub(r"(?i)(api[_-]?key\s*[=:]\s*)\S+", r"\1[redacted]", text)
text = re.sub(r"(?i)(token:\s*)\S+", r"\1[redacted]", text)
text = re.sub(r"(?i)(Bearer\s+)\S+", r"\1[redacted]", text)
sys.stdout.write(text)
'
}

# Redacted last-N-lines of a run's stderr for the durable error step.
# Fail-soft: missing file → empty stdout, exit 0.
_stderr_tail_redacted() {
    local file="${1:-}" n="${2:-15}"
    [[ -n "$file" && -f "$file" ]] || return 0
    [[ "$n" =~ ^[0-9]+$ ]] || n=15
    tail -n "$n" -- "$file" 2>/dev/null | _redact_stream
}

# Last attempted command of a failed run, for the durable error step: the
# newest reasoning step carrying this run_id in the trajectory tail, plus the
# paired shell exit when one is visible. Truncated and redacted — enough to
# show the SHAPE of what the model tried (stray ```bash fence, wrong
# subcommand or flag style) without archiving a raw command blob. Empty when
# the run died before its first command (e.g. provider failure on the opening
# llm call). Reads _probe_tail, so call after _refresh_probe.
_attempted_cmd_redacted() {
    local run_id="${1:-}" max_chars="${2:-400}"
    [[ -n "$run_id" && -n "${_probe_tail:-}" ]] || return 0
    [[ "$max_chars" =~ ^[0-9]+$ ]] || max_chars=400
    printf '%s\n' "$_probe_tail" | jq -Rrs --arg rid "$run_id" --argjson max "$max_chars" '
        [ split("\n")[] | fromjson? | select((.run_id // "") == $rid) ] as $steps
        | ([$steps[] | select(.type == "reasoning") | .cmd // ""] | last // "") as $cmd
        | ([$steps[] | select(.type == "shell-output") | .exit] | last) as $exit
        | if $cmd == "" then empty else
            ($cmd | .[0:$max])
            + (if ($cmd | length) > $max then "…[truncated]" else "" end)
            + (if $exit == null then "" else "\n(last shell exit: " + ($exit | tostring) + ")" end)
          end' 2>/dev/null | _redact_stream
}


# ---------------------------------------------------------------------------
# Gap sense — interoception of the between-wakes (design/gap_sense.md).
# Sidecar is written here; the model only sees a one-line routing stanza.
# Fail-soft: a broken sense is silence (`gap: unknown`), never a fake clock.
# ---------------------------------------------------------------------------
_gap_fmt() {
    local s="${1:-0}"
    [[ "$s" =~ ^[0-9]+$ ]] || s=0
    if (( s < 60 )); then printf '%ss' "$s"
    elif (( s < 3600 )); then printf '%sm' "$(( s / 60 ))"
    elif (( s < 86400 )); then printf '%sh' "$(( s / 3600 ))"
    else printf '%sd' "$(( s / 86400 ))"
    fi
}

_gap_mtime() {
    local path="$1"
    [[ -e "$path" ]] || return 1
    stat -f %m "$path" 2>/dev/null || stat -c %Y "$path" 2>/dev/null
}

_gap_same_key() {
    # Coarse key: short type + crushed content stem. Not a semantic judge.
    local typ="$1" content="$2" short stem
    case "$typ" in
        observation) short=obs ;;
        action)      short=act ;;
        thought)     short=th ;;
        idle)        short=idle ;;
        merge)       short=merge ;;
        message)     short=msg ;;
        *)           short=$(printf '%s' "$typ" | cut -c1-8) ;;
    esac
    [[ -n "$short" ]] || short="unk"
    stem=$(printf '%s' "$content" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//;s/-*$//' | cut -c1-40)
    [[ -n "$stem" ]] || stem="empty"
    printf '%s+%s' "$short" "$stem"
}

_gap_world_moved() {
    # Cheap OR: this wake is reactive, or a file under mem/chat/inbox is newer
    # than the previous monolith end. Directory mtime alone is not a knock —
    # mkdir of an empty folder (identity setup) is not the room speaking.
    local prev_end="$1" mt path f
    if [[ "${wake_mode:-}" == "reactive" ]]; then
        return 0
    fi
    [[ "$prev_end" =~ ^[0-9]+$ ]] || return 1
    for path in \
        "${MEM_DIR:-}" \
        "${IDENTITY_DIR:-}/chat" \
        "${IDENTITY_DIR:-}/inbox" \
        "${IDENTITY_DIR:-}/run/hermes-inbox"
    do
        [[ -n "$path" && -e "$path" ]] || continue
        if [[ -f "$path" ]]; then
            mt=$(_gap_mtime "$path") || continue
            if (( mt > prev_end )); then
                return 0
            fi
            continue
        fi
        [[ -d "$path" ]] || continue
        while IFS= read -r -d '' f; do
            mt=$(_gap_mtime "$f") || continue
            if (( mt > prev_end )); then
                return 0
            fi
        done < <(find "$path" -type f -print0 2>/dev/null)
    done
    return 1
}

_stamp_gap_end() {
    # EXIT: record when this process actually ended. Keep other sidecar fields.
    local now tmp
    [[ -n "${gap_file:-}" ]] || return 0
    now=$(date +%s) || return 0
    mkdir -p "$(dirname "$gap_file")" 2>/dev/null || return 0
    if [[ -f "$gap_file" ]]; then
        tmp=$(mktemp "${gap_file}.XXXXXX") || return 0
        if jq --argjson t "$now" '.t_prev_end=$t' "$gap_file" > "$tmp" 2>/dev/null; then
            mv "$tmp" "$gap_file"
        else
            rm -f "$tmp"
            printf '{"schema":"gap/v0","t_prev_end":%s}\n' "$now" > "$gap_file" 2>/dev/null || true
        fi
    else
        printf '{"schema":"gap/v0","t_prev_end":%s}\n' "$now" > "$gap_file" 2>/dev/null || true
    fi
}

_gap_refresh() {
    # Read previous sidecar, compute this wakeup's sense, inject stanza, write.
    # Sets: gap_stanza (always), and rewrites $gap_file.
    local now prev_end gap_s since_non last_type last_content same_key
    local consecutive world body prev_same prev_consec prev_since
    local last_json stanza room
    gap_stanza="gap: unknown"
    now=$(date +%s) || now=0

    last_type=""
    last_content=""
    last_json=""
    if traj exists 2>/dev/null; then
        last_json=$(traj tail -n 1 --raw --filter source=monolith --match-bounded 2>/dev/null) || last_json=""
    fi
    if [[ -n "$last_json" ]]; then
        last_type=$(printf '%s' "$last_json" | jq -r '.type // empty' 2>/dev/null) || last_type=""
        last_content=$(printf '%s' "$last_json" | jq -r '.content // empty' 2>/dev/null) || last_content=""
    fi
    same_key=$(_gap_same_key "${last_type:-unk}" "$last_content")

    prev_end=""
    prev_same=""
    prev_consec=0
    prev_since=""
    if [[ -f "$gap_file" ]]; then
        prev_end=$(jq -r '.t_prev_end // empty' "$gap_file" 2>/dev/null) || prev_end=""
        prev_same=$(jq -r '.same_key // empty' "$gap_file" 2>/dev/null) || prev_same=""
        prev_consec=$(jq -r '.consecutive_same // 0' "$gap_file" 2>/dev/null) || prev_consec=0
        prev_since=$(jq -r '.since_non_idle_s // empty' "$gap_file" 2>/dev/null) || prev_since=""
    fi
    [[ "$prev_consec" =~ ^[0-9]+$ ]] || prev_consec=0

    if [[ -z "$prev_end" || ! "$prev_end" =~ ^[0-9]+$ ]]; then
        body="first-light"
        gap_s=0
        since_non=0
        consecutive=0
        world=false
        stanza="gap: unknown"
    else
        gap_s=$(( now - prev_end ))
        (( gap_s < 0 )) && gap_s=0
        if _gap_world_moved "$prev_end"; then
            world=true
        else
            world=false
        fi
        if [[ "$world" == "true" || -z "$prev_same" || "$same_key" != "$prev_same" ]]; then
            consecutive=1
        else
            consecutive=$(( prev_consec + 1 ))
        fi
        if [[ "$last_type" == "idle" ]]; then
            if [[ "$prev_since" =~ ^[0-9]+$ ]]; then
                since_non=$(( prev_since + gap_s ))
            else
                since_non=$gap_s
            fi
        else
            since_non=$gap_s
        fi
        if (( gap_s >= 1800 )); then
            body="returning"
        elif [[ "$last_type" == "idle" && "$world" == "false" ]]; then
            body="resting"
        elif (( consecutive >= 3 && gap_s < 600 )); then
            body="spinning"
        else
            body="in-stride"
        fi
        if [[ "$world" == "true" ]]; then room="room knocked"; else room="room quiet"; fi
        stanza=$(printf 'gap: %s since last end · %s since a non-idle · %s ×%s (%s) · %s' \
            "$(_gap_fmt "$gap_s")" \
            "$(_gap_fmt "$since_non")" \
            "$body" \
            "$consecutive" \
            "$same_key" \
            "$room")
    fi
    gap_stanza="$stanza"

    mkdir -p "$(dirname "$gap_file")" 2>/dev/null || true
    local tmp
    tmp=$(mktemp "${gap_file}.XXXXXX") || return 0
    if jq -n \
        --arg schema "gap/v0" \
        --argjson t_prev_end "${prev_end:-0}" \
        --argjson t_now "$now" \
        --argjson gap_s "${gap_s:-0}" \
        --argjson since_non_idle_s "${since_non:-0}" \
        --argjson consecutive_same "${consecutive:-0}" \
        --arg same_key "$same_key" \
        --argjson world_moved "$world" \
        --arg body "$body" \
        '{
          schema:$schema,
          t_prev_end:$t_prev_end,
          t_now:$t_now,
          gap_s:$gap_s,
          since_non_idle_s:$since_non_idle_s,
          consecutive_same:$consecutive_same,
          same_key:$same_key,
          world_moved:$world_moved,
          body:$body
        }' > "$tmp" 2>/dev/null; then
        mv "$tmp" "$gap_file"
    else
        rm -f "$tmp"
    fi
}

# ---------------------------------------------------------------------------
# Parse the triggering step
# ---------------------------------------------------------------------------
step_json=$(cat)
[[ -z "$step_json" ]] && exit 0
trigger_type=$(printf '%s' "$step_json" | jq -r '.type // empty' 2>/dev/null) || true
trigger_source=$(printf '%s' "$step_json" | jq -r '.source // empty' 2>/dev/null) || true
trigger_step_id=$(printf '%s' "$step_json" | jq -r '.step_id // empty' 2>/dev/null) || true
trigger_content=$(printf '%s' "$step_json" | jq -r '.content // empty' 2>/dev/null) || true

# ---------------------------------------------------------------------------
# EXIT-trap liveness: arm the next timer on the way out, on EVERY exit — crash,
# refusal, and no-op paths included — so run/<name>.wake_at is ALWAYS re-armed
# and the loop cannot die by "appending nothing" the way trigger_self used to
# guard against. next_delay is set to 0 (arm an immediate wake — keep thinking)
# or delay(level) (rest) by the handlers below; if a path exits with it still
# empty (early no-op wakes, deaths before classification), default to the
# current backoff delay rather than skipping the re-arm.
# ---------------------------------------------------------------------------
next_delay=""
trap 'arm_wake "${next_delay:-$(_delay_for_level "$level")}"; _stamp_gap_end' EXIT

# Classify the wake. With trigger_self:false the dispatcher already filters our
# own steps, so these are all external — but stay defensive.
case "$trigger_type" in
    message)
        # We do not subscribe to message (responder owns chat). Defensive no-op;
        # the EXIT trap still re-arms spontaneity.
        exit 0
        ;;
    observation|action|merge)
        if [[ "$trigger_source" == "$THINKER_NAME" ]]; then
            exit 0   # our own step — should not arrive; trap re-arms.
        fi
        wake_mode="reactive"     # an external event — engage
        ;;
    monolith-wake)
        wake_mode="spontaneous"  # scheduled self-check — classify by work done
        ;;
    *)
        # idle / manual-trigger / initial start wake / watchdog / unknown: treat
        # as a spontaneity/bootstrap wake so the timer loop (re)starts from here.
        wake_mode="spontaneous"
        ;;
esac

# Liveness fallback: from here on we WILL run, so guarantee the trap arms a
# timer even if this run dies early under `set -e` (arming the timer, not an
# appended step, is what keeps the trigger_self:false loop alive). The proper
# decision at the end overrides next_delay before a clean exit.
next_delay=$(_delay_for_level "$level")

# ---------------------------------------------------------------------------
# ROUTER path — one agentic run over the function menu
# ---------------------------------------------------------------------------
system_prompt=$(_build_system_prompt)

recent_context=""
if traj exists 2>/dev/null; then
    recent_context=$(_recent_stream "$THINK_CONTEXT_TAIL") || recent_context=""
fi

# Cheap deterministic routing hints (nudges, not rules — the model decides).
hints=""
# (No reply-state hint: replies are the responder thinker's job, not ours.)
last_three=$(printf '%s\n' "$recent_context" | tail -n 3)
if printf '%s' "$recent_context" | tail -n 1 | jq -e 'select(.type == "action")' >/dev/null 2>&1; then
    hints="${hints}- The most recent step is an ACTION that has no observation yet — it may need carrying out (act).
"
fi
if [[ $(printf '%s\n' "$last_three" | jq -r '.type' 2>/dev/null | sort -u | tr '\n' ' ') == "thought " ]]; then
    hints="${hints}- The last few steps are all thoughts — the stream may be circling; consider acting, recalling, or advancing decisively.
"
fi
# Unabsorbed external observations (hermes/overseer/mailbox) are the job of
# this wakeup. Surface them as the wake seed so the first reasoning step
# cannot skip past them into a generic orientation probe.
if [[ "$wake_mode" == "reactive" && -n "$trigger_content" ]]; then
    _seed=$(printf '%s' "$trigger_content" | tr '\n' ' ' | cut -c1-800)
    hints="${hints}- REACTIVE wake from ${trigger_source:-unknown} (${trigger_type}). This observation is the job — do not spend the step checking wake type, chat history, or resting. Act on it or record why not.
  wake seed: ${_seed}
"
fi
# Pending requests from the responder (design/conversation_memory.md, part 5):
# the responder told someone "let me look into that" and appended an `action`
# (source responder, trigger_step = their message) describing the work. It is
# pending until an observation carries resolves=<that trigger_step>. `chat
# pending` reads the deferrals index over the whole trajectory, so a request
# stays visible however many steps or newer requests pile on top of it (the
# old recent-stream scan showed only the newest one, inside a 20-step window:
# on 2026-09-02 a request was masked by a newer one, then aged out unseen).
# Every open request is listed, oldest first, with its age; past
# PENDING_OVERDUE_S (4h) the hint says so. The hint gives the exact delivery
# command so the reply lands on the right message. The wording is a strong
# preference with a stated escape hatch, not an order: on 2026-09-03 two
# timer wakes in a row read the hint and filed research notes instead,
# under Audel's own "timer wakeups are for inner life" rule, and said
# nothing about why. A declined request must now leave a thought behind.
PENDING_MAX_AGE="${MONOLITH_PENDING_MAX_AGE:-14d}"
PENDING_OVERDUE_S="${MONOLITH_PENDING_OVERDUE_S:-14400}"
PENDING_LIST_MAX="${MONOLITH_PENDING_LIST_MAX:-5}"
pending_req=""
if command -v chat >/dev/null 2>&1; then
    pending_req=$(chat pending --json --max-age "$PENDING_MAX_AGE" 2>/dev/null | jq -r \
        --argjson overdue "$PENDING_OVERDUE_S" --argjson max "$PENDING_LIST_MAX" '
        def age_text: if . < 3600 then "\(. / 60 | floor) min"
                      elif . < 86400 then "\(. / 3600 | floor) h"
                      else "\(. / 86400 | floor) d" end;
        (length) as $n
        | .[0:$max]
        | (.[] | "- PENDING REQUEST from \(.person // "someone"): \(.request)"
            + " (pending for \(.age_s | age_text)"
            + (if .age_s > $overdue then ", OVERDUE: deliver what you have, or that it cannot be done, this wake" else "" end)
            + "). The responder already told them you would get back to them, so they are waiting. Strongly prefer doing this work now (act), timer wake or not, over inner-life work; then deliver the result with exactly: chat reply --follow-up --reply-to \(.trigger_step) \(.person // "<their-name>") \"<result>\"  — and append an observation with --field resolves=\(.trigger_step) so this request stops showing here. If you have a good reason not to this wake, append a thought saying why and what would unblock it."),
          (if $n > $max then "- \($n - $max) more pending requests: run `chat pending` to see them all." else empty end)' 2>/dev/null) || pending_req=""
fi
[[ -n "$pending_req" ]] && hints="${hints}${pending_req}
"
# Share nudge: outward initiative needs a periodic prompt-side invitation, or
# restraint rules learned from feedback ratchet the mind into pure listening
# (observed on Audel 2026-08-21: a self-imposed "last-word-ours -> do not
# speak" doctrine, goals.md-codified the next day). Counts SPONTANEOUS wakes;
# reactive wakes have their own engagement. The counter resets when the hint
# fires, not when a message is sent: an invitation every N quiet wakes, never
# an order.
if [[ "$SHARE_HINT_EVERY" -gt 0 && "$wake_mode" == "spontaneous" ]]; then
    wakes_since_share_hint=$(( wakes_since_share_hint + 1 ))
    if (( wakes_since_share_hint >= SHARE_HINT_EVERY )); then
        wakes_since_share_hint=0
        hints="${hints}- It has been a while since you shared anything outward. If recent work or thinking produced something a specific person would genuinely care about, consider **share**. If nothing qualifies, ignore this.
"
    fi
fi
# Goal review nudge: once every GOAL_REVIEW_DAYS, ask for the goals function
# with the housekeeping spelled out. Goals only ever got added on Audel
# (13 goal memories, 3 shown, duplicates and expired todos among them, 2026-09-04).
_now_s=$(date -u +%s)
if [[ "$GOAL_REVIEW_DAYS" -gt 0 ]] && (( _now_s - goal_review_at >= GOAL_REVIEW_DAYS * 86400 )); then
    goal_review_at="$_now_s"
    hints="${hints}- GOAL REVIEW (about once a week): read your active goals below and tidy them this wake (goals). Retire what is done or stale with \`mem forget\`, merge duplicates with \`mem edit\`, and give open todos a date with \`mem add --type todo --until YYYY-MM-DD\` so they expire on their own.
"
fi
# The query for related memories is the wake's own material: the real hints
# (before the placeholder below) and the last three stream steps.
related_query="$hints $(printf '%s\n' "$recent_context" | tail -n 3 | jq -r '.content // ""' 2>/dev/null | cut -c1-600 | tr '\n' ' ')"
[[ -z "$hints" ]] && hints="- (no special signals — pick what best serves the mind right now)
"
# Gap sense: one line, injected here so it cannot be skipped the way a
# sidecar file or `traj show` would be. Failure → `gap: unknown`.
gap_stanza="gap: unknown"
_gap_refresh || true
hints="${gap_stanza}
${hints}"

prompt_file="$SCRIPT_DIR/prompt.md"
[[ -f "$prompt_file" ]] || { printf 'monolith/step: error: prompt.md not found at %s\n' "$prompt_file" >&2; exit 1; }
goals=$(get_goals "$MEM_DIR")
think_prompt=$(load_prompt "$prompt_file" "$IDENTITY_NAME" "$goals")

# Build shellm flags (includes traj/mem/chat/etc. in --bin).
shellm_flags=()
while IFS= read -r _flag; do
    [[ -n "$_flag" ]] && shellm_flags+=("$_flag")
done < <(_build_shellm_flags "$IDENTITY_DIR" "$run_dir")

# Tiered "life so far" memory (on by default; set MONOLITH_TIERED_MEMORY=0 to
# disable). recap --context builds rollups only GOING FORWARD from first use, so
# this is safe even on a long pre-existing log — the past stays uncovered until
# someone runs `recap --backfill` once. _life_context degrades to empty on any
# error. See design/tiered_memory.md.
life_section=""
if [[ "${MONOLITH_TIERED_MEMORY:-1}" == "1" ]]; then
    _lc=$(_life_context) || _lc=""
    [[ -n "$_lc" ]] && life_section="Your life so far (tiered summary, oldest→newest). A record of what happened, not a rule for what comes next: past stretches of waiting, restraint, or one line of research do not bind this wakeup.
$_lc

"
fi

# Related memories: up to RELATED_MEMORIES one-line pointers into the memory
# store, matched to this wake's material. Names shown go into the state file
# so the next wake shows different ones. See design/related_memories.md.
related_section=""
related_shown=""
if [[ "$RELATED_MEMORIES" -gt 0 ]]; then
    _rm=$(_related_memories "$related_query" "$related_prev" "$RELATED_MEMORIES" 2>/dev/null) || _rm=""
    if [[ -n "$_rm" ]]; then
        related_shown=$(printf '%s\n' "$_rm" | sed -n 's/^- \([^ ]*\) \[.*/\1/p')
        related_section="Related memories (matched to this wake from your memory store; \`mem show <name>\` prints one whole; if one is wrong or stale, fix it with \`mem edit\` or \`mem forget\`):
$_rm

"
    fi
fi

# Job + routing FIRST. The rest of this prompt is tens of KB (skills,
# identity, recent stream). Trajectory inline storage and some context
# views keep only ~4096 bytes; if the wake seed sits at the end the
# model never sees the observation it is supposed to absorb.
route_prompt="Choose ONE function for this wakeup and carry it out now.

${related_section}Routing signals:
$hints

$think_prompt

<context>
$system_prompt

${life_section}Recent stream (last $THINK_CONTEXT_TAIL steps):
$recent_context
</context>"

# Work probe: compare the last REAL-WORK step id before/after the run. Real work
# is thought/action/observation/merge/message (NOT idle — a fallback idle is not
# progress). Drives the backoff classification below.
# Reads the tail of the root trajectory (_root_traj_raw_tail), NOT `traj cat`
# over the whole file — that was O(file size) and ran TWICE per wakeup (a 312MB
# log = two full 312MB scans per wake). A work step this run appends lands in
# the last handful of lines, well inside the tail window, so before/after stays
# correct. -R reads each line as a raw STRING so fromjson parses it and corrupt
# lines are skipped. See design/monolith_run_health.md A3.
# VISIBLE work (action/observation/merge/message: something happened outside
# the head) resets the backoff; a THOUGHT alone advances the stream but no
# longer counts as engagement, or writing "nothing changed" is scored like
# doing something and the loop re-fires at full speed forever (observed on
# Audel: back-to-back runs each concluding "listen-only").
_probe_tail=""
_refresh_probe() {
    _probe_tail=$(_root_traj_raw_tail 2>/dev/null) || _probe_tail=""
}
_last_visible_id() {
    printf '%s\n' "$_probe_tail" \
        | jq -Rr 'fromjson? // empty
            | select(.type == "action" or .type == "observation"
                     or .type == "merge" or .type == "message")
            | .step_id // empty' 2>/dev/null \
        | tail -n 1
}

# Run shellm with an INACTIVITY timeout plus a wall-clock ceiling. shellm's own
# watchdog (SHELLM_INACTIVITY_TIMEOUT/MAX) guards a single exec block; this
# wrapper guards the whole run, catching a shellm that wedges between blocks or
# hangs on a provider stream. Two kill conditions:
#   quiet — no stderr growth for SHELLM_STEP_TIMEOUT s (default
#           SHELLM_INACTIVITY_MAX, 900). A healthy long run streams output
#           continuously, so run length alone never kills it. (A pure
#           wall-clock kill at 900s killed healthy 15-minute runs and drove
#           backoff to the cap — maint-20260903-185858.)
#   wall  — SHELLM_STEP_WALL_MAX s total (default 7200, 0 disables): the
#           backstop so a single step can never wedge the thinker.
# On kill the child process tree is terminated (TERM then KILL), rc is 124,
# run_timeout_{kind,limit,quiet,elapsed} carry the activity snapshot for the
# durable error step, and a marker line is appended to the stderr file so both
# the live log and the error step's tail name the killer.

_run_with_timeout() {
    local quiet_max="${SHELLM_STEP_TIMEOUT:-${SHELLM_INACTIVITY_MAX:-900}}"
    local wall_max="${SHELLM_STEP_WALL_MAX:-7200}"
    local run_id_file="$1"
    local run_stderr_file="$2"
    # $3 is the prompt FILE path, not the prompt string: a mature identity's
    # wakeup prompt exceeds MAX_ARG_STRLEN as an argv (rc=126), so it goes via
    # --prompt-file. See the prompt_file_tmp note below.
    local prompt_file="$3"

    # Use temp files for stdout/stderr capture
    local stdout_file
    stdout_file=$(mktemp)

    # Start shellm in background
    {
        SHELLM_NO_BANNER=1 \
        SHELLM_TRIGGER_STEP_ID="$trigger_step_id" \
        SHELLM_WAKE="$wake_reason" \
        SHELLM_RUN_ID_OUT="$run_id_file" \
        shellm --model "$THINK_MODEL" --traj "$TRAJ_ID" --context-scope run \
            "${shellm_flags[@]}" \
            --prompt-file "$prompt_file" >"$stdout_file" 2>"$run_stderr_file"
        echo $? > "${stdout_file}.rc"
    } &
    local shellm_pid=$!

    # Also tee stderr to the thinker log (fd 2) for live visibility
    ( tail -f "$run_stderr_file" >&2 ) &
    local tail_pid=$!

    # Watch for inactivity (stderr stops growing) or the wall ceiling
    local start_ts now cur_size quiet elapsed kind limit
    start_ts=$(date +%s)
    local last_size=0
    local last_change_ts="$start_ts"
    local rc=0
    while kill -0 "$shellm_pid" 2>/dev/null; do
        sleep 2
        now=$(date +%s)
        cur_size=$(wc -c < "$run_stderr_file" 2>/dev/null | tr -d ' ') || cur_size=0
        if [[ "$cur_size" != "$last_size" ]]; then
            last_size="$cur_size"
            last_change_ts="$now"
        fi
        quiet=$(( now - last_change_ts ))
        elapsed=$(( now - start_ts ))
        kind=""
        limit=""
        if [[ "$quiet" -ge "$quiet_max" ]]; then
            kind="quiet"; limit="$quiet_max"
        elif [[ "$wall_max" -gt 0 && "$elapsed" -ge "$wall_max" ]]; then
            kind="wall"; limit="$wall_max"
        fi
        if [[ -n "$kind" ]]; then
            run_timeout_kind="$kind"
            run_timeout_limit="$limit"
            run_timeout_quiet="$quiet"
            run_timeout_elapsed="$elapsed"
            # Name the killer in the run's own stderr so the log and the
            # error step's tail show WHY the run died, not just that it died.
            printf '%s [step-timeout] %s limit %ss hit (quiet %ss, elapsed %ss): killing shellm pid %s\n' \
                "$(date -u +%FT%TZ)" "$kind" "$limit" "$quiet" "$elapsed" "$shellm_pid" \
                >> "$run_stderr_file"
            # Kill the shellm process tree.
            # Portable approach: find children via pgrep -P (works on Linux and macOS)
            local children
            children=$(pgrep -P "$shellm_pid" 2>/dev/null) || children=""
            [[ -n "$children" ]] && kill -TERM $children 2>/dev/null || true
            kill -TERM "$shellm_pid" 2>/dev/null || true
            sleep 1
            children=$(pgrep -P "$shellm_pid" 2>/dev/null) || children=""
            [[ -n "$children" ]] && kill -KILL $children 2>/dev/null || true
            kill -KILL "$shellm_pid" 2>/dev/null || true
            rc=124  # timeout exit code
            break
        fi
    done

    # Clean up tail process
    kill "$tail_pid" 2>/dev/null || true

    # Read the exit code if shellm exited on its own
    if [[ $rc -eq 0 ]] && [[ -f "${stdout_file}.rc" ]]; then
        rc=$(cat "${stdout_file}.rc" 2>/dev/null) || rc=0
    fi

    # Capture stdout
    run_response=$(cat "$stdout_file" 2>/dev/null) || run_response=""

    # Cleanup temp files
    rm -f "$stdout_file" "${stdout_file}.rc"

    return $rc
}


_last_thought_id() {
    printf '%s\n' "$_probe_tail" \
        | jq -Rr 'fromjson? // empty | select(.type == "thought")
            | .step_id // empty' 2>/dev/null \
        | tail -n 1
}
before_visible=""
before_thought=""
if traj exists 2>/dev/null; then
    _refresh_probe
    before_visible=$(_last_visible_id) || before_visible=""
    before_thought=$(_last_thought_id) || before_thought=""
fi

# shellm writes its run header's step_id here, so a fallback idle can carry
# run_id and the timeline can pair it with the run that went quiet.
run_id_file=$(mktemp)
# shellm's stderr is tee'd here so a failed run's error step can carry the
# provider context (redacted) — without it an rc=1 step says nothing about WHY.
run_stderr_file=$(mktemp)

# One shellm agentic run (writes to the root trajectory). Model via --model so
# it cannot be shadowed by env/.env layers (see design/model-resolution.md).
printf '  routing (%s / %s)...\n' "${trigger_type:-none}" "$wake_mode" >&2

# Why this wakeup happened, stamped onto the shellm-run step so the mind can
# read it back later. Without it the rendered run row is 500 chars of launcher
# argv; with it the row says which thinker woke and what woke it.
case "$trigger_type" in
    monolith-wake) wake_reason="$wake_mode/timer" ;;
    "")            wake_reason="$wake_mode/start" ;;
    *)             wake_reason="$wake_mode/$trigger_type${trigger_source:+:$trigger_source}" ;;
esac
# The prompt goes to shellm as a FILE, not an argv string. Linux caps one
# argv string at 128KB (MAX_ARG_STRLEN) and a mature identity's wakeup prompt
# (life summary + recent stream) passes that, which made every run die with
# "Argument list too long" (rc=126) before it started. See
# design/monolith_run_health.md.
prompt_file_tmp=$(mktemp "$state_dir/monolith_prompt.XXXXXX")
printf '%s' "$route_prompt" > "$prompt_file_tmp"
run_rc=0
run_timeout_kind=""
run_timeout_limit=""
run_timeout_quiet=""
run_timeout_elapsed=""
# Run shellm under the inactivity/wall guard. The prompt goes via file
# (prompt_file_tmp, created above) to dodge MAX_ARG_STRLEN; --context-scope run
# and --prompt-file are applied inside _run_with_timeout.
_run_with_timeout "$run_id_file" "$run_stderr_file" "$prompt_file_tmp" || run_rc=$?
rm -f "$prompt_file_tmp"
run_response="$run_response"  # set by _run_with_timeout

after_visible=""
after_thought=""
if traj exists 2>/dev/null; then
    _refresh_probe
    after_visible=$(_last_visible_id) || after_visible=""
    after_thought=$(_last_thought_id) || after_thought=""
fi
did_visible=0
[[ "$after_visible" != "$before_visible" ]] && did_visible=1
did_thought=0
[[ "$after_thought" != "$before_thought" ]] && did_thought=1
# Any durable step (either tier) gates the fallback idle/error marker below.
did_work=0
[[ "$did_visible" -eq 1 || "$did_thought" -eq 1 ]] && did_work=1

# Classify the run's ending: a FAILED run (rc != 0) is not the same as a calm
# decision to idle. Record EVERY failure as a visible `error` step — even when
# the run wrote durable work before dying — otherwise crashes masquerade as
# healthy resting or completed work, invisible on the timeline and to the
# operator, and wrongly pace the mind. Four rc=1 wakes in ~5min left nothing
# but stderr tails to diagnose from (maint-20260906-051155). See
# design/monolith_run_health.md B2. (Under trigger_self:false neither step
# drives the loop — the EXIT trap's arm_wake does — they just mark the wake.)
run_errored=0
[[ "$run_rc" -ne 0 ]] && run_errored=1
if [[ "$run_errored" -eq 1 || "$did_work" -eq 0 ]]; then
    idle_run_id=$(cat "$run_id_file" 2>/dev/null) || idle_run_id=""
    if [[ "$run_errored" -eq 1 ]]; then
        durable_note="with no durable step"
        [[ "$did_work" -eq 1 ]] && durable_note="after writing durable step(s)"
        # A wrapper-induced timeout kill is not a generic run failure: name it
        # (reason=step-timeout) and carry the activity snapshot, so the
        # trajectory shows a diagnosable kill instead of a bare rc=124.
        if [[ "$run_rc" -eq 124 && -n "$run_timeout_kind" ]]; then
            err_reason="step-timeout"
            err_content="monolith run killed by step timeout (${run_timeout_kind} limit ${run_timeout_limit}s; quiet ${run_timeout_quiet}s, elapsed ${run_timeout_elapsed}s) ${durable_note}"
            printf '  run TIMED OUT (%s limit %ss) — recording step-timeout\n' \
                "$run_timeout_kind" "$run_timeout_limit" >&2
        else
            err_reason="run-failed"
            err_content="monolith run failed (rc=${run_rc}) ${durable_note}"
            printf '  run FAILED (rc=%s) — recording error\n' "$run_rc" >&2
        fi
        # Provider context: redacted tail of the run's stderr, so the failure
        # mode (e.g. "OpenRouter empty stream") is diagnosable from the
        # trajectory alone instead of only from run/logs/monolith.log.
        err_tail=$(_stderr_tail_redacted "$run_stderr_file" "${MONOLITH_ERROR_TAIL_LINES:-15}") || err_tail=""
        # Command context: what the run last TRIED (truncated, redacted), so
        # the shape of a failure — a stray ```bash fence, a bad `mem`/`traj`
        # invocation — is visible to signal detectors and the mind itself,
        # not only its stderr symptom.
        err_cmd=$(_attempted_cmd_redacted "$idle_run_id" "${MONOLITH_ERROR_CMD_CHARS:-400}") || err_cmd=""
        jq -nc \
            --arg source "$THINKER_NAME" \
            --arg trigger "$trigger_step_id" \
            --arg run_id "$idle_run_id" \
            --arg err_tail "$err_tail" \
            --arg err_cmd "$err_cmd" \
            --arg content "$err_content" \
            --arg reason "$err_reason" \
            --arg tkind "$run_timeout_kind" \
            --arg tlimit "$run_timeout_limit" \
            --arg tquiet "$run_timeout_quiet" \
            --arg telapsed "$run_timeout_elapsed" \
            --argjson rc "$run_rc" \
            '{type:"error",
              content:($content
                       + (if $err_cmd == "" then "" else "\nlast attempted cmd (truncated, redacted):\n" + $err_cmd end)
                       + (if $err_tail == "" then "" else "\nstderr tail:\n" + $err_tail end)),
              source:$source, reason:$reason, rc:$rc}
             + (if $reason != "step-timeout" then {} else
                 {timeout:{kind:$tkind, limit_s:($tlimit|tonumber),
                           quiet_s:($tquiet|tonumber), elapsed_s:($telapsed|tonumber)}} end)
             + (if $trigger == "" then {} else {trigger_step: $trigger} end)
             + (if $run_id == "" then {} else {run_id: $run_id} end)' \
            | traj append >/dev/null || true
    else
        printf '  run produced no durable step (rc=0) — marking idle; timer keeps the loop alive\n' >&2
        jq -nc \
            --arg source "$THINKER_NAME" \
            --arg trigger "$trigger_step_id" \
            --arg run_id "$idle_run_id" \
            '{type:"idle", content:"idle", source:$source}
             + (if $trigger == "" then {} else {trigger_step: $trigger} end)
             + (if $run_id == "" then {} else {run_id: $run_id} end)' \
            | traj append >/dev/null || true
    fi
fi
rm -f "$run_id_file" "$run_stderr_file"

# ---------------------------------------------------------------------------
# Backoff decision — sets next_delay for the EXIT trap.
# ---------------------------------------------------------------------------
if [[ "$wake_mode" == "reactive" || "$did_visible" -eq 1 ]]; then
    # Engaged, or the run did real work → reset to no pause; think again at once.
    level=0
    ticks_at_level=0
    next_delay=0
elif [[ "$run_errored" -eq 1 ]]; then
    # Failed run, no durable step → descend a level IMMEDIATELY (no HOLD dwell)
    # so a persistently failing run reaches the slow cap fast and wastes few
    # tokens, while staying visible (error step above). Never tight-loops; never
    # resets to fast retry (a broken run isn't "engaged"). See B2.
    if (( $(_delay_for_level "$level") < BACKOFF_CAP )); then
        level=$(( level + 1 ))
    fi
    ticks_at_level=0
    next_delay=$(_delay_for_level "$level")
else
    # Empty spontaneous wake → dwell at this rate, then descend one level.
    ticks_at_level=$(( ticks_at_level + 1 ))
    if (( ticks_at_level >= BACKOFF_HOLD )); then
        # Step to the next (slower) level unless already resting at the cap.
        if (( $(_delay_for_level "$level") < BACKOFF_CAP )); then
            level=$(( level + 1 ))
        fi
        ticks_at_level=0
    fi
    next_delay=$(_delay_for_level "$level")
    if [[ "$did_thought" -eq 1 ]]; then
        # Thought-only: same ladder, gentler ceiling. The stream of
        # consciousness slows to a tick, not to the full rest cap.
        (( next_delay > THOUGHT_CAP )) && next_delay=$THOUGHT_CAP
        printf '  thought-only wake — dwell %s/%s at level %s (next in %ss)\n' \
            "$ticks_at_level" "$BACKOFF_HOLD" "$level" "$next_delay" >&2
    fi
fi
_save_state

if [[ -n "$run_response" ]]; then
    printf '  [monolith] %s\n' "$(printf '%s' "$run_response" | head -1)"
fi
